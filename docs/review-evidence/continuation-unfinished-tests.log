                            samples,
                            weights,
                            k_max=request.k_max,
                            subsample=request.auto_k_subsample,
                            rng=context.generator,
                            config=config,
                            em_options=em,
                        )
                        fit, p_values = chosen.fit, chosen.boundary_p_values
                        selection = chosen.diagnostics
                    else:
